generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  CASHIER
  TRADER
  FINANCE
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum IdType {
  NATIONAL_ID
  PASSPORT
  DRIVING_LICENSE
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PLACED
  BET_WON
  BET_REFUND
  BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentProvider {
  AIRTEL_MONEY
  ORANGE_MONEY
  MOOV_MONEY
  CASH
}

enum EventStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

enum MarketType {
  MATCH_WINNER
  DOUBLE_CHANCE
  OVER_UNDER
  BOTH_TEAMS_SCORE
  HANDICAP
  CORRECT_SCORE
  FIRST_GOAL_SCORER
  HALF_TIME_RESULT
  DRAW_NO_BET
  ALTERNATE_TOTALS
  ALTERNATE_SPREADS
  TEAM_TOTALS
  // Résultat d'une seule mi-temps (h2h_h1/h2h_h2 TheOddsAPI) et marchés
  // statistiques (corners, cartons) — voir odds.service.ts syncPropMarkets.
  // Non calculables automatiquement depuis /scores (TheOddsAPI ne fournit
  // ni le score à la mi-temps ni les corners/cartons) : réglage manuel par
  // un trader via PATCH /api/admin/tickets/:id/result.
  FIRST_HALF_WINNER
  SECOND_HALF_WINNER
  CORNERS_TOTAL
  CORNERS_HANDICAP
  CARDS_TOTAL
  CARDS_HANDICAP
  // Mêmes familles de marchés que le match complet (plus/moins, handicap,
  // double chance), déclinées par mi-temps — voir odds.service.ts
  // syncHalfMarkets. Clés TheOddsAPI non garanties pour toutes les
  // rencontres/bookmakers (couverture moindre qu'en match complet) : lot
  // isolé pour ne pas faire régresser syncPropMarkets si l'une d'elles
  // s'avère invalide.
  FIRST_HALF_TOTALS
  FIRST_HALF_HANDICAP
  FIRST_HALF_DOUBLE_CHANCE
  SECOND_HALF_TOTALS
  SECOND_HALF_HANDICAP
  SECOND_HALF_DOUBLE_CHANCE
  // Niveau 1 — calculables à partir du seul score final (odds.service.ts
  // computeItemResult), réglage 100% automatique.
  ODD_EVEN_TOTAL
  CLEAN_SHEET
  WIN_TO_NIL
  WINNING_MARGIN
  TEAM_GOALS
  // Niveau 2 — nécessitent le score mi-temps (stats-settlement.ts),
  // réglage auto via API-Football ou saisie manuelle du trader.
  HALF_TIME_CORRECT_SCORE
  HALF_TIME_FULL_TIME
  BOTH_HALVES_SCORE
  // Niveau 3 — extraits de la même réponse API-Football que corners/cartons.
  SHOTS_ON_TARGET_TOTAL
  FOULS_TOTAL
}

enum BetType {
  SINGLE
  ACCUMULATOR
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
  REFUNDED
  MANUAL_REVIEW
}

enum BetItemResult {
  WON
  LOST
  VOID
}

enum WithdrawalRequestStatus {
  PENDING
  VALIDATED
  CANCELLED
  EXPIRED
}

enum TpeStatus {
  PENDING_PAIRING
  ACTIVE
  BLOCKED
  DELETED
}

enum TicketStatus {
  PENDING
  WON
  LOST
  REFUNDED
  CANCELLED
  PAID
  // Cash-out accepté par le joueur depuis le site public (serenitybetcode.com)
  // : montant figé (voir cashedOutAmount), en attente d'encaissement physique
  // au TPE — bascule ensuite en PAID une fois réellement payé en espèces
  // (voir payCashout, tpe.service.ts), comme un ticket gagnant classique.
  CASHED_OUT_PENDING
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  playerNumber Int        @unique @default(autoincrement())
  email        String     @unique
  phone        String     @unique
  password     String
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  role         Role       @default(PLAYER)
  status       UserStatus @default(ACTIVE)
  kycStatus    KycStatus  @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Tout token (accès ou rafraîchissement) émis avant cette date est rejeté
  // par authenticate()/refreshTokens(), quelle que soit sa durée de validité
  // propre — posé à la date courante lors d'une déconnexion, pour que "se
  // déconnecter" invalide réellement la session côté serveur plutôt que de
  // laisser un token volé/réutilisé fonctionner jusqu'à son expiration
  // naturelle (jusqu'à 24h). Vérifié via le Postgres déjà interrogé à chaque
  // requête authentifiée — pas de dépendance à Redis (optionnel/dégradable
  // dans ce projet) pour un contrôle de sécurité critique.
  tokensRevokedAt DateTime?

  shopId              String?
  shop                Shop?          @relation("CashierShop", fields: [shopId], references: [id])

  wallet              Wallet?
  cashierWallet       CashierWallet?
  savedCoupons        SavedCoupon[]
  partnerReferral     PartnerReferral?  @relation("PartnerReferral")
  bets                Bet[]
  transactions        Transaction[]
  sessions            Session[]
  kyc                 Kyc?
  withdrawalRequests  WithdrawalRequest[]
  ticketsCreated      Ticket[]            @relation("TicketCashier")
  ticketsPaid         Ticket[]            @relation("TicketPaidBy")
  tpeCreditAdjustments TpeCreditAdjustment[]

  @@index([email])
  @@index([phone])
  @@index([playerNumber])
  @@index([role])
  @@index([status])
}

model Kyc {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  idType     IdType
  idNumber   String
  frontImage String
  backImage  String
  selfie     String?
  status     KycStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  balance      BigInt        @default(0) // centimes XAF
  bonusBalance BigInt        @default(0)
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id            String            @id @default(cuid())
  walletId      String
  wallet        Wallet            @relation(fields: [walletId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  type          TransactionType
  amount        BigInt            // centimes XAF (positif = crédit, négatif = débit)
  balanceBefore BigInt
  balanceAfter  BigInt
  status        TransactionStatus @default(PENDING)
  provider      PaymentProvider?
  providerRef   String?           // référence de la transaction Mobile Money
  phoneNumber   String?           // numéro Mobile Money
  betId         String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Sport {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  icon         String?
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  competitions Competition[]
}

model Competition {
  id       String  @id @default(cuid())
  sportId  String
  sport    Sport   @relation(fields: [sportId], references: [id])
  name     String
  slug     String  @unique
  country  String?
  logo     String?
  isActive Boolean @default(true)
  events   Event[]

  @@index([sportId])
}

model Event {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  externalId    String?     @unique // ID from odds API
  homeTeam      String
  awayTeam      String
  homeTeamLogo  String?
  awayTeamLogo  String?
  startTime     DateTime
  status        EventStatus @default(UPCOMING)
  homeScore     Int?
  awayScore     Int?
  minute        Int?        // minute de jeu (live)
  result        String?
  markets       Market[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Version du jeu de marchés additionnels (BTTS, score exact...) déjà
  // récupéré pour ce match — incrémentée côté code à chaque élargissement
  // du jeu de marchés, pour retraiter une seule fois les matchs déjà faits
  // sous une version antérieure (voir odds.service.ts EXTRA_MARKETS_VERSION).
  extraMarketsVersion Int @default(0)

  // Même principe que extraMarketsVersion, mais pour un lot de marchés
  // séparé (1ère/2nde mi-temps, corners, cartons) récupéré par son propre
  // appel API indépendant — voir odds.service.ts PROP_MARKETS_VERSION. Lot
  // distinct volontairement : si une des clés de marché s'avère invalide
  // côté TheOddsAPI, seul ce lot échoue, sans jamais faire régresser la
  // synchronisation des marchés additionnels déjà en place (BTTS, double
  // chance...).
  propMarketsVersion Int @default(0)

  // Même principe que propMarketsVersion, pour le lot "mêmes marchés que le
  // match complet, déclinés par mi-temps" (plus/moins, handicap, double
  // chance) — voir odds.service.ts HALF_MARKETS_VERSION. Lot distinct pour
  // la même raison : isoler un échec sur une clé encore non confirmée côté
  // TheOddsAPI du reste des marchés déjà éprouvés.
  halfMarketsVersion Int @default(0)

  // Nombre de tentatives de règlement automatique via API-Football (mi-temps,
  // corners, cartons — voir api-football.service.ts) pour cet évènement.
  // Le forfait gratuit d'API-Football est très limité en débit/quota
  // journalier : sans ce compteur, un match jamais trouvé côté API-Football
  // (championnat non couvert, décalage de date...) serait retenté à chaque
  // cycle pour toujours, gaspillant le quota — on abandonne après
  // API_FOOTBALL_MAX_ATTEMPTS tentatives (le ticket reste alors en réglage
  // manuel, comme avant l'intégration de cette API).
  apiFootballAttempts Int @default(0)

  @@index([competitionId])
  @@index([status])
  @@index([startTime])
}

model Market {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id])
  name        String
  type        MarketType
  isActive    Boolean    @default(true)
  isSuspended Boolean    @default(false)
  odds        Odd[]
  betItems    BetItem[]
  ticketItems TicketItem[]

  @@index([eventId])
  @@index([type])
}

model Odd {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id])
  label       String   // "1", "X", "2", "Over", "Under", "Yes", "No"
  value       Decimal  @db.Decimal(8, 3) // cote décimale ex: 2.500
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  betItems    BetItem[]
  ticketItems TicketItem[]

  @@index([marketId])
}

model Bet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          BetType
  stake         BigInt    // centimes XAF
  totalOdds     Decimal   @db.Decimal(10, 3)
  potentialWin  BigInt    // centimes XAF
  status        BetStatus @default(PENDING)
  isManualCheck Boolean   @default(false) // flaggé pour revue risque
  settledAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  items         BetItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([isManualCheck])
}

model BetItem {
  id       String         @id @default(cuid())
  betId    String
  bet      Bet            @relation(fields: [betId], references: [id])
  marketId String
  market   Market         @relation(fields: [marketId], references: [id])
  oddId    String
  odd      Odd            @relation(fields: [oddId], references: [id])
  oddValue Decimal        @db.Decimal(8, 3)
  result   BetItemResult?

  @@index([betId])
  @@index([marketId])
}

// ─── Portefeuille caissier (float espèces) ───────────────────────────────────

model CashierWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Coupons sauvegardés (tickets physiques) ─────────────────────────────────

model SavedCoupon {
  id         String    @id @default(cuid())
  code       String    @unique
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  selections Json
  suggestedStake BigInt?
  status     String    @default("PENDING")
  expiresAt  DateTime
  usedAt     DateTime?
  betId      String?
  createdAt  DateTime  @default(now())

  @@index([code])
  @@index([userId])
  @@index([status])
}

// ─── Programme d'affiliation partenaires ─────────────────────────────────────

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PartnerWithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

model Partner {
  id              String               @id @default(cuid())
  email           String               @unique
  phone           String               @unique
  password        String
  firstName       String
  lastName        String
  bio             String?
  socialMedia     String?
  promoCode       String               @unique
  commissionRate  Float                @default(0.10) // 10% par défaut
  status          PartnerStatus        @default(PENDING)
  balance         Float                @default(0)
  totalEarned     Float                @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  referrals       PartnerReferral[]
  commissions     PartnerCommission[]
  withdrawals     PartnerWithdrawal[]

  @@index([promoCode])
  @@index([status])
}

model PartnerReferral {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  userId      String   @unique
  user        User     @relation("PartnerReferral", fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([partnerId])
}

model PartnerCommission {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  userId      String
  betId       String?
  amount      Float
  rate        Float
  description String?
  createdAt   DateTime @default(now())

  @@index([partnerId])
  @@index([createdAt])
}

model PartnerWithdrawal {
  id          String                  @id @default(cuid())
  partnerId   String
  partner     Partner                 @relation(fields: [partnerId], references: [id])
  amount      Float
  method      String
  account     String
  status      PartnerWithdrawalStatus @default(PENDING)
  processedAt DateTime?
  notes       String?
  createdAt   DateTime                @default(now())

  @@index([partnerId])
  @@index([status])
}

// ─── Boutiques (salles de jeux physiques) ─────────────────────────────────────

model Shop {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  withdrawalRequests WithdrawalRequest[]
  cashiers           User[]              @relation("CashierShop")

  @@index([city])
  @@index([isActive])
}

// ─── Demandes de retrait espèces ─────────────────────────────────────────────

model WithdrawalRequest {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  shopId      String
  shop        Shop                    @relation(fields: [shopId], references: [id])
  amount      BigInt
  status      WithdrawalRequestStatus @default(PENDING)
  requestCode String                  @unique
  cashierId   String?
  completedAt DateTime?
  expiresAt   DateTime
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([userId])
  @@index([shopId])
  @@index([status])
  @@index([requestCode])
  @@index([expiresAt])
}

// ─── TPE (terminaux physiques — tickets anonymes) ────────────────────────────

// Regroupement géographique des TPE (ex. agences par ville/quartier) —
// permet de gérer le risque par zone : un plafond de gain propre à la
// région prévaut sur le réglage global (Setting TPE_MAX_WIN_XAF) pour tous
// les TPE qui lui sont rattachés.
model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  // centimes XAF — null = hérite du plafond global ; 0 = explicitement
  // désactivé pour cette région (aucun plafond), même si un plafond global
  // existe par ailleurs.
  maxWinXAF BigInt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tpes Tpe[]
}

model Tpe {
  id               String    @id @default(cuid())
  code             String    @unique // Ex: TPE-0001, affecté à l'appairage
  name             String?
  deviceSecretHash String    @unique // hash du secret généré par l'appareil
  pairingCode      String?   @unique // affiché sur l'appareil tant qu'en attente d'appairage
  status           TpeStatus @default(PENDING_PAIRING)
  credit           BigInt    @default(0) // centimes XAF — plafond de paiement alimenté par le backoffice
  // Palier journalier (centimes XAF) — si défini, credit est remis à cette
  // valeur automatiquement chaque jour à minuit (heure du Tchad, UTC+1), à
  // la place d'une recharge manuelle ponctuelle (demande explicite du
  // 30/10/2026) : un caissier ne se retrouve plus bloqué en pleine journée
  // en attendant qu'un admin recharge manuellement. null = désactivé
  // (comportement historique, recharge manuelle uniquement).
  dailyCreditXAF   BigInt?
  // Dernière réinitialisation automatique effectuée (voir
  // resetDailyCreditsIfDue, tpe.service.ts) — sert à savoir si celle
  // d'aujourd'hui a déjà eu lieu, et à rattraper celles manquées après un
  // redémarrage/une panne du serveur ayant couvert minuit.
  lastDailyResetAt DateTime?
  regionId         String?
  region           Region?   @relation(fields: [regionId], references: [id])
  lastSeenAt       DateTime?
  pairedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ticketsCreated    Ticket[]               @relation("TpeTicketsCreated")
  ticketsPaid       Ticket[]               @relation("TpeTicketsPaid")
  creditAdjustments TpeCreditAdjustment[]

  @@index([status])
  @@index([pairingCode])
  @@index([regionId])
}

model TpeCreditAdjustment {
  id        String   @id @default(cuid())
  tpeId     String
  tpe       Tpe      @relation(fields: [tpeId], references: [id])
  amount    BigInt   // centimes XAF — positif = recharge, négatif = retrait
  reason    String?
  // null = réinitialisation automatique du palier journalier (voir
  // Tpe.dailyCreditXAF), pas d'admin à l'origine de ce mouvement-là.
  adminId   String?
  admin     User?    @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())

  @@index([tpeId])
}

model Ticket {
  id               String       @id @default(cuid())
  code             String       @unique // code imprimé sur le ticket papier
  // Code de validation à 4 chiffres, imprimé une seule fois sur le ticket
  // ORIGINAL (jamais sur une réimpression) et exigé pour encaisser — empêche
  // qu'une réimpression du même ticket soit présentée frauduleusement au
  // paiement par quelqu'un qui n'a pas l'original en main.
  payoutCode       String? // null pour les tickets émis avant l'introduction de ce contrôle
  tpeId            String
  tpe              Tpe          @relation("TpeTicketsCreated", fields: [tpeId], references: [id])
  cashierId        String
  cashier          User         @relation("TicketCashier", fields: [cashierId], references: [id])
  stake            BigInt       // centimes XAF
  totalOdds        Decimal      @db.Decimal(10, 3)
  potentialWin     BigInt       // centimes XAF
  status           TicketStatus @default(PENDING)
  requiresApproval Boolean      @default(false)
  approvedAt       DateTime?
  approvedBy       String?
  settledAt        DateTime?
  paidAt           DateTime?
  paidByTpeId      String?
  paidByTpe        Tpe?         @relation("TpeTicketsPaid", fields: [paidByTpeId], references: [id])
  paidByCashierId  String?
  paidByCashier    User?        @relation("TicketPaidBy", fields: [paidByCashierId], references: [id])
  // Cash-out (voir enum TicketStatus.CASHED_OUT_PENDING) — montant figé au
  // moment où le joueur l'accepte sur le site, en centimes XAF, distinct de
  // potentialWin (qui reste la valeur d'un règlement normal, au cas où le
  // joueur aurait plutôt attendu la fin du ticket).
  cashedOutAmount  BigInt?
  cashedOutAt      DateTime?
  createdAt        DateTime     @default(now())
  items            TicketItem[]
  // Coupon web d'origine, le cas échéant — un même coupon peut être retiré
  // plusieurs fois (par le parieur et ses amis à qui il a partagé le code)
  // jusqu'à expiration, donc plusieurs tickets peuvent pointer vers le même
  // WebCoupon (voir WebCoupon.tickets).
  webCouponId      String?
  webCoupon        WebCoupon?   @relation(fields: [webCouponId], references: [id])

  @@index([tpeId])
  @@index([status])
  @@index([code])
  @@index([createdAt])
  @@index([webCouponId])
}

model TicketItem {
  id       String         @id @default(cuid())
  ticketId String
  ticket   Ticket         @relation(fields: [ticketId], references: [id])
  marketId String
  market   Market         @relation(fields: [marketId], references: [id])
  oddId    String
  odd      Odd            @relation(fields: [oddId], references: [id])
  oddValue Decimal        @db.Decimal(8, 3)
  result   BetItemResult?

  @@index([ticketId])
  @@index([marketId])
}

// Coupon composé depuis le site public (sans compte — contrairement à
// SavedCoupon, qui suppose un joueur authentifié avec portefeuille). Ne
// contient que les sélections ; la mise est décidée en espèces en boutique,
// où le caissier le convertit en Ticket (voir placeTicket/webCouponCode).
//
// Usage multiple et volontaire : un même code reste valable jusqu'à
// expiration et n'est jamais consommé à la première utilisation — un
// parieur peut composer son coupon et partager le code avec des amis, qui
// peuvent chacun le faire retirer séparément (chacun avec sa propre mise)
// en boutique. D'où la relation 1-N vers Ticket (tickets) plutôt que 1-1.
model WebCoupon {
  id         String          @id @default(cuid())
  code       String          @unique
  selections Json            // snapshot [{ eventId, eventLabel, marketId, marketName, oddId, oddLabel, oddValue }]
  status     WebCouponStatus @default(PENDING)
  tickets    Ticket[]
  createdAt  DateTime        @default(now())
  expiresAt  DateTime

  @@index([status])
  @@index([expiresAt])
}

enum WebCouponStatus {
  PENDING
  USED
  EXPIRED
  CANCELLED
}

// Bannières promotionnelles du carrousel en haut de la page d'accueil du
// site joueur (apps/web) — gérées depuis le backoffice. imageUrl est une
// URL externe collée à la main (même pattern que Competition.logo) : pas
// d'infrastructure d'upload de fichier dans ce projet.
model PromoBanner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─── Configuration backoffice (clé/valeur) ───────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}
