# ─── Copier ces variables dans le dashboard Railway ────────────────────────────

# Base de données (votre URL Neon — SANS &channel_binding=require)
DATABASE_URL=postgresql://neondb_owner:MOT_DE_PASSE@ep-xxx.neon.tech/neondb?sslmode=require

# Redis (votre URL Upstash)
REDIS_URL=rediss://default:MOT_DE_PASSE@xxx.upstash.io:6379

# JWT (changez ces valeurs ! Min 32 caractères aléatoires)
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_minimum_32_chars
JWT_REFRESH_SECRET=votre_refresh_secret_tres_long_et_aleatoire_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=4000
NODE_ENV=production

# Origins autorisées (URLs Vercel de vos deux apps, séparées par des virgules)
ALLOWED_ORIGINS=https://serenitybet.vercel.app,https://serenitybet-bo.vercel.app

# Cotes sportives (optionnel)
ODDS_API_KEY=your_the_odds_api_key
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_SYNC_INTERVAL_MS=60000

# Seuil de risque (en centimes XAF — 5 000 000 = 50 000 XAF)
RISK_MAX_PAYOUT_XAF=5000000

# Paiements Mobile Money (sandbox pour les tests)
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_ENV=sandbox

ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/cm/v1
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_SECRET=

MOOV_MONEY_BASE_URL=https://api.moov-africa.td
MOOV_MONEY_API_KEY=
MOOV_MONEY_MERCHANT_ID=

# URL publique du backoffice (pour les webhooks)
APP_BASE_URL=https://serenitybet-bo.vercel.app
WEBHOOK_SECRET=changeme_webhook_secret_32chars
