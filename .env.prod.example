# Copier en .env (à côté de docker-compose.prod.yml, sur le serveur — NE JAMAIS commiter ce fichier rempli)

POSTGRES_USER=serenitybet
POSTGRES_PASSWORD=changez_ce_mot_de_passe_postgres
POSTGRES_DB=serenitybet_db

# Générer avec : openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Générer avec : openssl rand -hex 32 — fait partie de l'URL de callback à
# déclarer dans l'espace marchand de chaque opérateur mobile money :
# https://.../api/webhooks/airtel-money/<WEBHOOK_SECRET>
# https://.../api/webhooks/orange-money/<WEBHOOK_SECRET>
# https://.../api/webhooks/moov-money/<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Seuil de risque pari (centimes XAF) — 5 000 000 = 50 000 XAF
RISK_MAX_PAYOUT_XAF=5000000

# Domaines HTTPS routés par Caddy (voir /etc/caddy/Caddyfile sur le serveur)
# — à adapter si tu changes de domaine
ALLOWED_ORIGINS=https://serenitybet-admin.krcbet.com,https://serenitybet-tpe.krcbet.com
NEXT_PUBLIC_API_URL=https://serenitybet-api.krcbet.com/api
