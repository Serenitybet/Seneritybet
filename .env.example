# ─── Base de données ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://serenitybet:serenitybet@localhost:5432/serenitybet_db"
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET="changeme_jwt_secret_64chars_minimum"
JWT_REFRESH_SECRET="changeme_refresh_secret_64chars_minimum"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV="development"

# ─── Cotes sportives ─────────────────────────────────────────────────────────
ODDS_API_KEY="your_the_odds_api_key"
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"
ODDS_SYNC_INTERVAL_MS=30000

# ─── Seuil de risque ─────────────────────────────────────────────────────────
# Gain potentiel max (en centimes XAF) avant validation manuelle
RISK_MAX_PAYOUT_XAF=5000000

# ─── Paiements Mobile Money ──────────────────────────────────────────────────
AIRTEL_MONEY_BASE_URL="https://openapi.airtel.africa"
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
AIRTEL_MONEY_ENV="sandbox"

ORANGE_MONEY_BASE_URL="https://api.orange.com/orange-money-webpay/cm/v1"
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_SECRET=""

MOOV_MONEY_BASE_URL="https://api.moov-africa.td"
MOOV_MONEY_API_KEY=""
MOOV_MONEY_MERCHANT_ID=""

# ─── Webhooks ────────────────────────────────────────────────────────────────
WEBHOOK_SECRET="changeme_webhook_secret"
APP_BASE_URL="http://localhost:3000"

# ─── Next.js (apps/web) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="Serenitybet"

# ─── Next.js (apps/backoffice) ───────────────────────────────────────────────
NEXT_PUBLIC_BACKOFFICE_API_URL="http://localhost:4000/api"
