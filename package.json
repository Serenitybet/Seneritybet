{
  "name": "serenitybet",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "turbo run db:migrate --filter=@serenitybet/db",
    "db:seed": "turbo run db:seed --filter=@serenitybet/db",
    "db:studio": "turbo run db:studio --filter=@serenitybet/db",
    "db:generate": "turbo run db:generate --filter=@serenitybet/db"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
